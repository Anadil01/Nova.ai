generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PRO
  POWER
}

enum JobSource {
  NAUKRI
  LINKEDIN
  INDEED
  INTERNSHALA
  MANUAL
}

enum AppStatus {
  APPLIED
  VIEWED
  SCREENED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum ConversationState {
  IDLE
  ONBOARDING_ROLE
  ONBOARDING_EXP
  ONBOARDING_SKILLS
  ONBOARDING_CITY
  AWAITING_CONFIRM
  IN_FLOW
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String?
  waConnected   Boolean   @default(false)
  plan          UserPlan  @default(FREE)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  resumes       Resume[]
  applications  Application[]
  conversations Conversation[]
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetRole     String?
  experienceYrs  Int      @default(0)
  currentTitle   String?
  currentCompany String?
  city           String?
  workMode       WorkMode @default(HYBRID)
  salaryMin      Int?
  salaryMax      Int?
  skills         String[] @default([])
  industries     String[] @default([])
  linkedinUrl    String?
  portfolioUrl   String?
  summary        String?
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]
  educations  Education[]

  @@map("user_profiles")
}

model Experience {
  id          String      @id @default(cuid())
  profileId   String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean     @default(false)
  description String?
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Education {
  id        String      @id @default(cuid())
  profileId String
  degree    String
  school    String
  year      Int?
  cgpa      Float?
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String?
  workMode    WorkMode  @default(ONSITE)
  jobType     JobType   @default(FULL_TIME)
  salaryMin   Int?
  salaryMax   Int?
  description String?
  skills      String[]  @default([])
  source      JobSource
  sourceUrl   String    @unique
  sourceId    String?
  postedAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  scrapedAt   DateTime  @default(now())

  applications Application[]

  @@index([title, company])
  @@index([scrapedAt])
  @@map("jobs")
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  name       String
  targetRole String?
  targetJob  String?
  atsScore   Int?
  version    Int      @default(1)
  content    Json
  pdfUrl     String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("resumes")
}

model Application {
  id          String    @id @default(cuid())
  userId      String
  jobId       String
  resumeId    String?
  coverLetter String?
  status      AppStatus @default(APPLIED)
  appliedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  notes       String?
  autoApplied Boolean   @default(false)
  followUpAt  DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id])

  @@unique([userId, jobId])
  @@index([userId, status])
  @@map("applications")
}

model Conversation {
  id        String            @id @default(cuid())
  userId    String            @unique
  phone     String
  state     ConversationState @default(IDLE)
  context   Json              @default("{}")
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversations")
}